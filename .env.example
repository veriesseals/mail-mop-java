# Copy this file to .env and fill in real local values.
# .env is gitignored and must never be committed.

# --- Local PostgreSQL (dev profile) ---
DB_USERNAME=mailmop_user
DB_PASSWORD=replace-with-your-local-postgres-password

# --- Auth ---
# Optional for local dev — application.yml has a dev fallback secret.
# Any random string of 32+ characters.
# JWT_SECRET=

# --- Bootstrap admin account (used by the accounts module, a later step) ---
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-initial-admin-password

# --- Added in later steps. Leave unset for now. ---
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# EMAIL_FROM=no-reply@mailmop.app
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
